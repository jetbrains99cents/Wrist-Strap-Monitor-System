################################################################################
# General Project & OS
################################################################################

# Jetbrains IDE config directory/.idea
/.idea

# Miscellaneous
.DS_Store
.AppleDouble
.LSOverride

# Thumbnails
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# Files that might appear on external disk
.Spotlight-V100
.Trashes

# Windows image file caches
ehthumbs_vista.db

# Folder config file
[Dd]esktop.ini

# Recycle Bin used on file shares
$RECYCLE.BIN/

# Passwords
*.password
*.key
*.secret
*.pem
*.cert

# Logs
*.log
logs/
*.log.*

# Temporary files
*.tmp
*.temp
*.bak
*.swp
*~
*.old
*.swo

# Local environment variables
.env
.env.*
!.env.example
!.env.sample

################################################################################
# JetBrains IDEs (PyCharm, CLion, WebStorm, IntelliJ IDEA, etc.)
################################################################################
# Covers JetBrains IDEs: IntelliJ, RubyMine, PhpStorm, AppCode, PyCharm, CLion, Android Studio, WebStorm
# Reference: https://intellij-support.jetbrains.com/hc/en-us/articles/206544839

# User-specific stuff
.idea/workspace.xml
.idea/tasks.xml
.idea/datasources.xml
.idea/datasources.local.xml
.idea/dataSources.ids
.idea/dataSources.local.ids
.idea/sqlDataSources.xml
.idea/dynamic.xml
.idea/uiDesigner.xml
.idea/dbnavigator.xml
.idea/shelf/
.idea/vcs.xml # Can be useful to share, but often contains local paths
.idea/sonarlint/ # SonarLint plugin
.idea/markdown/ # Markdown Navigator plugin
.idea/externalDependencies.xml # Rider specific

# Sensitive or high-churn files
.idea/runConfigurations/ # Usually machine-specific or user-specific
.idea/libraries/ # Auto-generated, can be large and change often
.idea/modules.xml # Generated by IDE, can cause conflicts if not careful

# CLion specific
cmake-build-*/

# Gradle:
.idea/gradle.xml
.idea/libraries/

# Mongo Explorer plugin:
.idea/mongoSettings.xml

## File-based project format:
*.ipr
*.iws

## Plugin-specific files:
# IntelliJ / WebStorm / PyCharm out/ directory
out/

# JetBrains Rider
*.sln.dotSettings.user

# Rider IDE
.idea/.idea.*/.idea/workspace.xml
.idea/.idea.*/.idea/shelf

################################################################################
# Python
################################################################################

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
# Usually these files are written by a python script from a template
# before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.pytest_cache/

# Translations
*.mo
*.pot

# Django stuff
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal

# Flask stuff
instance/
.webassets-cache

# Jupyter Notebook
.ipynb_checkpoints

# IPython
profile_default/
ipython_config.py

# pyenv
.python-version

# pipenv
# Pipfile.lock should often be committed, but some prefer to ignore it
# Pipfile.lock

# PEP 582; used by e.g. github.com/David-OConnor/pyflow
__pypackages__/

# Celery stuff
celerybeat-schedule
celerybeat.pid

# Environments
.env/
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/
pythonenv/

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# pytype static type analyzer
.pytype/

# Cython debug symbols
cython_debug/

